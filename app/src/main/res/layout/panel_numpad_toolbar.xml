<?xml version="1.0" encoding="utf-8"?>
<!-- Small toolbar above the suggestions: settings and 123 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/numpad_toolbar"
	android:layout_width="match_parent"
	android:layout_height="@dimen/numpad_toolbar_height"
	android:orientation="horizontal"
	android:gravity="center_vertical">

	<io.github.sspanak.tt9.ui.main.keys.SoftKeyToolbarSettings
		style="@style/TTheme.Numpad.Key.Arrow"
		android:id="@+id/soft_key_toolbar_settings"
		android:layout_width="@dimen/numpad_toolbar_button_width" />

	<View
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1" />

	<io.github.sspanak.tt9.ui.main.keys.SoftKeyToolbarNumeric
		style="@style/TTheme.Numpad.Key.Arrow"
		android:id="@+id/soft_key_toolbar_numeric"
		android:layout_width="@dimen/numpad_toolbar_button_width" />

</LinearLayout>
